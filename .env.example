# ==============================================================================
# Tiny Tales — Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Optional: Google Gemini API Key
# If provided, Tiny Tales will use Google Gemini (gemini-1.5-flash) to write original live stories.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: OpenAI API Key
# If Gemini is not set and OPENAI_API_KEY is provided, OpenAI gpt-4o-mini will be used.
OPENAI_API_KEY=

# Note: If neither key is provided, Tiny Tales automatically and seamlessly
# activates rich Demo Mode so the app is 100% functional out of the box with zero setup!
